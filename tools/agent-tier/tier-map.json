{
  "$comment": [
    "Danger-tier map for agent workers in propxchain-consumer. glob -> tier.",
    "highest matching tier wins; unmatched is tier 3; approved by Marc 2026-10-21",
    "Tightened 2026-10-22: served discovery/identity files, CSP headers, admin pages, wallet/signing pages and auth utilities are not agent work."
  ],

  "rules": [
    { "tier": 0, "glob": "docs/**" },
    { "tier": 0, "glob": "**/*.md" },
    { "tier": 0, "glob": "**/__tests__/**" },
    { "tier": 0, "glob": "src/test/**" },
    { "tier": 0, "glob": "**/*.test.ts" },
    { "tier": 0, "glob": "**/*.test.tsx" },

    { "tier": 1, "glob": "src/components/**" },
    { "tier": 1, "glob": "src/pages/**" },
    { "tier": 1, "glob": "src/hooks/**" },
    { "tier": 1, "glob": "src/styles/**" },
    { "tier": 1, "glob": "src/assets/**" },
    { "tier": 1, "glob": "public/**" },
    { "tier": 1, "glob": "src/constants/**" },
    { "tier": 1, "glob": "src/schemas/**" },
    { "tier": 1, "glob": "src/types/**" },
    { "tier": 1, "glob": "src/utils/**" },
    { "tier": 1, "glob": "src/lib/**" },

    { "tier": 2, "glob": "package.json" },
    { "tier": 2, "glob": "pnpm-lock.yaml" },
    { "tier": 2, "glob": "vite.config.ts" },
    { "tier": 2, "glob": "vitest.config.ts" },
    { "tier": 2, "glob": "tailwind.config.js" },
    { "tier": 2, "glob": "postcss.config.js" },
    { "tier": 2, "glob": "tsconfig*.json" },
    { "tier": 2, "glob": "index.html" },
    { "tier": 2, "glob": "scripts/**" },
    { "tier": 2, "glob": "config/**" },
    { "tier": 2, "glob": "src/config/**" },
    { "tier": 2, "glob": "src/services/**" },
    { "tier": 2, "glob": "src/stores/**" },
    { "tier": 2, "glob": "src/contexts/**" },
    { "tier": 2, "glob": "src/router/**" },
    { "tier": 2, "glob": "supabase/**" },
    { "tier": 2, "glob": "src/lib/supabase.ts" },

    { "tier": 3, "glob": ".github/**" },
    { "tier": 3, "glob": ".env*" },
    { "tier": 3, "glob": "dfx.json" },
    { "tier": 3, "glob": "canister_ids.json" },
    { "tier": 3, "glob": "android/**" },
    { "tier": 3, "glob": "ios/**" },
    { "tier": 3, "glob": "capacitor.config.ts" },
    { "tier": 3, "glob": "src/.well-known/**" },
    { "tier": 3, "glob": "src/components/auth/**" },
    { "tier": 3, "glob": "src/pages/auth/**" },
    { "tier": 3, "glob": "src/pages/payment/**" },
    { "tier": 3, "glob": "src/components/wallet/**" },
    { "tier": 3, "glob": "src/components/providers/**" },
    { "tier": 3, "glob": "src/components/admin/**" },
    { "tier": 3, "glob": ".mcp.json" },
    { "tier": 3, "glob": ".claude/**" },
    { "tier": 3, "glob": "public/.well-known/**" },
    { "tier": 3, "glob": "public/.ic-assets.json5" },
    { "tier": 3, "glob": "src/pages/admin/**" },
    { "tier": 3, "glob": "src/pages/WalletProofPage.tsx" },
    { "tier": 3, "glob": "src/pages/ExchangeSigningPage.tsx" },
    { "tier": 3, "glob": "src/utils/auth.ts" },
    { "tier": 3, "glob": "src/utils/oauthSignUpIntent.ts" }
  ]
}
