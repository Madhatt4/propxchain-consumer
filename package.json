    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.554.0",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.50.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.6",
