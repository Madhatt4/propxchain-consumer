    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "dompurify": ">=3.4.13",
      "postcss": ">=8.5.18",
      "nanoid": ">=3.3.18 <4",
      "react-router": ">=6.30.6 <7"
    }
  }
