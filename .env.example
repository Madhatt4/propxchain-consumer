# PropXchain consumer — environment variables
# Copy to .env.local and fill in real values. Do not commit .env.local.

# ─── Network ──────────────────────────────────────────────────────────────
VITE_DFX_NETWORK=ic

# ─── Canister IDs (mainnet defaults are hard-coded as fallbacks in src/) ── 
# Override here only if pointing at staging or local replica.
VITE_PROPERTY_REGISTRY_CANISTER_ID=
VITE_DOCUMENT_VERIFICATION_CANISTER_ID=
VITE_TRANSACTION_MANAGER_CANISTER_ID=
VITE_USER_MANAGEMENT_CANISTER_ID=
VITE_DOCUMENT_STORAGE_CANISTER_ID=
VITE_EMAIL_SERVICE_CANISTER_ID=
VITE_LEDGER_MANAGER_CANISTER_ID=
VITE_LAND_REGISTRY_CANISTER_ID=
VITE_MESSAGE_MANAGER_CANISTER_ID=
VITE_SKILL_RECEIPTS_CANISTER_ID=
VITE_ICP_CANISTER_ID=
VITE_INTERNET_IDENTITY_CANISTER_ID=

# Internet Identity *sign-in* is always on (no flag). II *registration* is
# gated separately — set to true to reopen II sign-up on the Register page.
VITE_ENABLE_II_REGISTRATION=false

# ─── ICP payments / treasury ──────────────────────────────────────────────
VITE_ICP_TREASURY_PRINCIPAL= 

# ─── Admin whitelist (comma-separated principals) ─────────────────────────
VITE_ADMIN_PRINCIPALS=

# ─── Supabase ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Stripe ───────────────────────────────────────────────────────────────
VITE_STRIPE_PUBLIC_KEY=
VITE_PAYMENT_WORKER_URL=

# ─── Cloudflare workers ───────────────────────────────────────────────────
VITE_API_BASE_URL=
VITE_CONVEYANCER_WORKER_URL=
VITE_RIGHTMOVE_WORKER_URL=
VITE_ONESEARCH_WORKER_URL=
# Required: GROUNDSURE_ENABLED is true, and an empty value here makes every
# Groundsure order silently mock instead of failing.
VITE_GROUNDSURE_WORKER_URL=
# Required: TMGROUP_ENABLED is true. Unlike the two above, an empty value here
# does NOT mock — tmgroup.service fails explicitly, because a fabricated tmGroup
# price is the exact bug removed on 2026-08-09.
# AML Worker — ID & AML checks (Verify365). Serves tier prices, check status and
# /order; the client never derives a price. Panel is inert without it.
VITE_AML_WORKER_URL=
VITE_TMGROUP_WORKER_URL=
VITE_SHIELDPAY_WORKER_URL=
VITE_VERIFY_SOLICITOR_URL=
VITE_OSCAR_BACKEND_URL=
# inspire-title Worker — point → registered title boundary (INSPIRE/FlatGeobuf on R2)
VITE_TITLE_WORKER_URL=
# CARTO basemaps key (browser-visible; request at carto.com/basemaps/apikey).
# Blank = the property map falls back to standard OpenStreetMap tiles.
VITE_CARTO_BASEMAPS_KEY=


# ─── Feature flags ────────────────────────────────────────────────────────
VITE_MAINTENANCE_MODE=false
VITE_ALLOW_DEV_AUTH=false

# ─── Mock mode (activate with NEXT_PUBLIC_USE_MOCK=true pnpm dev) ─────────
# Read by @propxchain/core-client. No canister calls when true.
NEXT_PUBLIC_USE_MOCK=false
